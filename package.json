{
  "name": "mop-flow",
  "version": "1.1.0",
  "description": "MOP Flow — portable agent memory core, workflow engine, and provider bridge for Claude, Codex, Gemini, and Antigravity.",
  "type": "module",
  "author": "BURHANDEV ENTERPRISE",
  "homepage": "https://github.com/BURHANDEV-ENTERPRISE/BURHAN-MOP#readme",
  "bugs": {
    "url": "https://github.com/BURHANDEV-ENTERPRISE/BURHAN-MOP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BURHANDEV-ENTERPRISE/BURHAN-MOP.git"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "memorycore",
    "mop-flow",
    "codex",
    "claude",
    "gemini",
    "antigravity",
    "workflow",
    "bmad",
    "autosync",
    "mcp",
    "cross-platform"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "burhan-mop": "bin/burhan-mop.mjs",
    "mop-core": "bin/mop-core.mjs",
    "mop-flow": "bin/mop-flow.mjs",
    "mop-workflow": "bin/mop-workflow.mjs"
  },
  "scripts": {
    "validate": "node .MOP/scripts/mop-core.mjs validate",
    "status": "node .MOP/scripts/mop-core.mjs status",
    "flow": "node .MOP/scripts/mop-flow.mjs status",
    "flow:manifest": "node .MOP/scripts/mop-flow.mjs manifest refresh",
    "workflow": "node .MOP/scripts/mop-workflow.mjs status",
    "doctor": "node .MOP/scripts/burhan-mop.mjs doctor",
    "test": "node .MOP/scripts/mop-smoke-test.mjs",
    "test:memory": "node .MOP/scripts/mop-smoke-test.mjs --suite memory",
    "lint": "node .MOP/scripts/mop-core.mjs validate --strict",
    "quality": "npm run lint && npm run test",
    "dashboard": "node .MOP/scripts/mop-dashboard.mjs",
    "dashboard:dev": "node .MOP/scripts/mop-dashboard.mjs --watch",
    "pack:dry": "npm pack --dry-run",
    "publish:dry": "npm publish --dry-run",
    "publish:public": "npm publish",
    "prepack": "npm run validate",
    "prepublishOnly": "npm run quality && npm run doctor",
    "prepare": "node -e \"const fs = require('fs'); if (fs.existsSync('.git/hooks')) { fs.writeFileSync('.git/hooks/pre-commit', '#!/bin/sh' + String.fromCharCode(10) + 'npm run quality' + String.fromCharCode(10), { mode: 511 }); console.log('Pre-commit hook installed.'); }\""
  },
  "files": [
    "bin",
    "README.bm.md",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "CONTRIBUTING.md",
    ".MOP",
    ".agents",
    ".claude/settings.json",
    ".claude/skills/mop-flow",
    ".claude/skills/auto-deploy",
    ".claude/skills/autosycn",
    ".claude/skills/mop-help",
    ".claude/skills/mop-browseract",
    ".claude/skills/mop-ui-clone",
    ".claude/skills/mop-docs-intel",
    ".codex",
    ".gemini",
    ".mcp.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "UNLICENSED"
}
